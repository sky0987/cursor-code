{
  "name": "sparks",
  "version": "1.3.0",
  "description": "Sparks - AI Coding Assistant, a powerful local AI coding tool with multi-provider support (OpenAI, Anthropic, Google, DeepSeek, etc.)",
  "main": "public/electron.js",
  "homepage": "https://github.com/sky0987/cursor-code",
  "author": {
    "name": "Long",
    "email": "sky8923587@163.com",
    "url": "https://github.com/sky0987"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sky0987/cursor-code.git"
  },
  "bugs": {
    "url": "https://github.com/sky0987/cursor-code/issues"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "electron",
    "react",
    "openai",
    "claude",
    "gemini",
    "deepseek",
    "cursor",
    "sparks"
  ],
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "https-proxy-agent": "^5.0.1",
    "node-fetch": "^2.7.0",
    "openai": "^6.33.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "ssh2": "^1.17.0",
    "typescript": "^4.9.5",
    "uuid": "^13.0.0",
    "web-vitals": "^2.1.4",
    "yaml": "^2.4.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "cross-env NODE_ENV=development electron . --dev",
    "electron:dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron\"",
    "electron:build": "npm run build && electron-builder --win"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.sparks.app",
    "productName": "Sparks",
    "icon": "public/icons/icons/win/icon.ico",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/icons/win/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icons/icons/win/icon.ico",
      "uninstallerIcon": "public/icons/icons/win/icon.ico",
      "installerHeaderIcon": "public/icons/icons/win/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "build/**/*",
      "public/electron.js"
    ],
    "forceCodeSigning": false,
    "publish": [
      {
        "provider": "github",
        "owner": "sky0987",
        "repo": "cursor-code"
      }
    ]
  }
}
